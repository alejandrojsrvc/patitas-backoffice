# En desarrollo, Vite redirige /api al backend para evitar CORS.
# Usa 127.0.0.1 para evitar problemas cuando localhost resuelve a IPv6.
VITE_DEV_API_TARGET=http://127.0.0.1:3000

# Mantener relativo para usar el proxy de Vite. Solo usa una URL absoluta si
# quieres saltarte el proxy y consumir la API desde otro origen.
VITE_API_URL=/api/v1
